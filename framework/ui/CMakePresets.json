{
  "version": 6,

  "configurePresets": [
    {
      "name": "windows-ui",
      "displayName": "Bench console (Windows, MinGW)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/ui",

      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },

      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/mingw64/bin/g++.exe",

        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "VCPKG_HOST_TRIPLET": "x64-mingw-dynamic",

        "THORIUM_UI_TEST_BINARY": "${sourceDir}/../../build/debug/bin/run_scripts"
      }
    }
  ]
}
