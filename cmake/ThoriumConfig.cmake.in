@PACKAGE_INIT@

#
# find_package(Thorium)'s entry point -- pulls in ThoriumTargets.cmake (the
# compiled Thorium::core/Thorium::hal targets, generated by the top-level
# CMakeLists.txt's install(EXPORT ThoriumTargets ...)). No find_dependency()
# calls: core/hal have no third-party dependency of their own (GoogleTest is
# test-only, never part of either target's installed interface).
#
# See the top-level CMakeLists.txt's own comment on what this package export
# does and does not give a consumer -- in particular, that Thorium::hal is
# only ever built for whichever rig supplied its four THORIUM_* instrument/
# wiring paths at the configure time this package was built and installed.
#
include("${CMAKE_CURRENT_LIST_DIR}/ThoriumTargets.cmake")

check_required_components(Thorium)
