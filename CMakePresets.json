{
  "version": 6,

  "configurePresets": [
    {
      "name": "macos",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/bin/gcc-16",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/bin/g++-16"
      }
    },

    {
      "name": "windows",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/mingw64/bin/g++.exe"
      }
    },

    {
      "name": "debug",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "release",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "macos-debug",
      "inherits": ["debug", "macos"]
    },

    {
      "name": "macos-release",
      "inherits": ["release", "macos"]
    },

    {
      "name": "windows-debug",
      "inherits": ["debug", "windows"]
    },

    {
      "name": "windows-release",
      "inherits": ["release", "windows"]
    }
  ]

}