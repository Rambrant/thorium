{
  "version": 6,

  "configurePresets": [
    {
      "name": "macos",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/bin/gcc-16",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/bin/g++-16"
      }
    },

    {
      "name": "windows",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/mingw64/bin/g++.exe"
      }
    },

    {
      "name": "debug",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "release",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "macos-debug",
      "inherits": ["debug", "macos"]
    },

    {
      "name": "macos-release",
      "inherits": ["release", "macos"]
    },

    {
      "name": "windows-debug",
      "inherits": ["debug", "windows"]
    },

    {
      "name": "windows-release",
      "inherits": ["release", "windows"]
    },

    {
      "name": "dev-deployment",
      "hidden": true,
      "cacheVariables": {
        "THORIUM_RIG_DIR": "${sourceDir}/dev/rig",
        "THORIUM_DUT_DIR": "${sourceDir}/dev/dut",
        "THORIUM_SUITE_DIR": "${sourceDir}/dev/suite",
        "THORIUM_KNOWN_CRITERIA_VARIANTS": "production",
        "THORIUM_INSTRUMENT_PACKAGES": "keysight_edu34450a",
        "THORIUM_DUT_NAME": "DevBench",
        "THORIUM_RIG_NAME": "dev-desk",
        "THORIUM_ACCEPTANCE_TESTS": "OFF"
      }
    },

    {
      "name": "macos-dev",
      "inherits": ["dev-deployment", "debug", "macos"],
      "binaryDir": "${sourceDir}/build/dev"
    },

    {
      "name": "windows-dev",
      "inherits": ["dev-deployment", "debug", "windows"],
      "binaryDir": "${sourceDir}/build/dev"
    }
  ]

}