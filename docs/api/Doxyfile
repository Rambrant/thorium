# Thorium -- generated API reference. An experiment; see docs/api/README.md.
#
# Hand-written and deliberately short rather than produced by `doxygen -g`:
# every setting here was chosen, and a 3000-line generated file would bury that
# in defaults. Doxygen fills in everything not named below.
#
# Run from the repository root:  doxygen docs/api/Doxyfile

PROJECT_NAME           = Thorium
PROJECT_BRIEF          = "Hardware test framework -- generated reference"
OUTPUT_DIRECTORY       = docs/api
STRIP_FROM_PATH        = .

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# The framework and this deployment's content. Not docs/ (the deck) and not
# third_party/.
INPUT                  = framework dsl dut rig suite instruments
FILE_PATTERNS          = *.hpp *.cpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */tests/* */third_party/* */cmake-build-*/*

# The whole point of the experiment: nothing carries a Doxygen tag, so without
# EXTRACT_ALL there is nothing to extract at all. Private members included --
# the interesting prose is as often on a data member as on a public method.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES

# See comment_filter.py: Doxygen ignores plain // comments, which is every
# comment in this tree. Applied to the parsed stream only, not to the source
# browser below (FILTER_SOURCE_FILES stays NO), so the browsable source shows
# the real file.
INPUT_FILTER           = "python3 docs/api/comment_filter.py"
FILTER_SOURCE_FILES    = NO

# Cross-referenced source is the half that a header cannot give you by itself,
# and so the half worth judging this experiment on.
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
HAVE_DOT               = YES

# Undocumented entities are the norm here, not a finding; real parse trouble is
# what the log is for.
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = docs/api/doxygen.warn
